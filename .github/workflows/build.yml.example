name: build

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

env:
  CARGO_TERM_COLOR: always

jobs:
  build:
    name: ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]

    steps:
      - uses: actions/checkout@v4

      - name: Cài phụ thuộc hệ thống (Linux)
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            ffmpeg \
            libxkbcommon-dev libwayland-dev libx11-dev libxi-dev \
            libgl1-mesa-dev libegl1-mesa-dev

      - name: Cài phụ thuộc hệ thống (Windows)
        if: runner.os == 'Windows'
        run: choco install ffmpeg -y --no-progress

      - name: Cài Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy

      - name: Cache cargo
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}

      - name: Định dạng
        run: cargo fmt --all -- --check
        continue-on-error: true

      - name: Clippy
        run: cargo clippy --all-targets -- -D warnings
        continue-on-error: true

      - name: Kiểm thử
        run: cargo test --release --verbose

      - name: Biên dịch
        run: cargo build --release --verbose

      - name: Đóng gói (Linux)
        if: runner.os == 'Linux'
        run: |
          mkdir -p dist/viedit-linux-x86_64
          cp target/release/viedit dist/viedit-linux-x86_64/
          cp -r assets dist/viedit-linux-x86_64/assets
          cp README.md LICENSE dist/viedit-linux-x86_64/
          cd dist && tar -czf viedit-linux-x86_64.tar.gz viedit-linux-x86_64

      - name: Đóng gói (Windows)
        if: runner.os == 'Windows'
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force -Path dist/viedit-windows-x64 | Out-Null
          Copy-Item target/release/viedit.exe dist/viedit-windows-x64/
          Copy-Item assets dist/viedit-windows-x64 -Recurse
          Copy-Item README.md, LICENSE dist/viedit-windows-x64/
          Compress-Archive -Path dist/viedit-windows-x64/* -DestinationPath dist/viedit-windows-x64.zip

      - uses: actions/upload-artifact@v4
        with:
          name: viedit-${{ matrix.os }}
          path: |
            dist/*.tar.gz
            dist/*.zip
          if-no-files-found: ignore
